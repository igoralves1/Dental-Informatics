const { setGlobalVars } = require("./global-vars");
const { Buffer } = require("buffer");
const { CallLog } = require("./data/call-log");
const { CallLogSearch } = require("./data/call-log-search");
const { CallLogDetailSelfService } = require("./data/call-log-detail-self-service");
const { ICallLogSearch } = require("./data/models");
const getExecutionContext = require('./data/execution-context');
const {
  EXECUTION_TYPE_STARTED,
  EXECUTION_TYPE_STEP_ENDED,
  EXECUTION_TYPE_ENDED,
  CALL_STATUS_COMPLETE
 } = require('./data/constants');

const moment = require('moment');
const merge = require('lodash/merge');

const util = require('./data/util');

const logCat = "ProcessTwilioKinesisStream";

module.exports.handler = async (event) => {
    const logSubCat = `${logCat}-handler`;
    setGlobalVars();

    Logger.info({ logCat, logSubCat, message: 'Event ', data: event });
    let searches = {};

    for (const record of event.Records) {
        try {
          const recordData = await getRecordDataAsync(record.kinesis);
          const data = JSON.parse(recordData);
          Logger.info({ logCat, logSubCat, message: 'Kinesis Row', data: data });

          const log = new CallLog(process.env.SHARD_ID,
                                  record.kinesis.sequenceNumber,
                                  record.kinesis.approximateArrivalTimestamp,
                                  data.type,
                                  data.data.execution_sid,
                                  data.time,
                                  data.data.started_by,
                                  data.data);

          if (!searches[log.pk]) {
            searches[log.pk] = new ICallLogSearch();
            searches[log.pk].type = data.type;
            searches[log.pk].executionId = data.data.execution_sid;
            searches[log.pk].flowSid = data.data.flow_sid;
            searches[log.pk].context = null;
            searches[log.pk].widgets = { };

            //==> Sometimes execution.start could come in a separate batch
            //==>   so we need to query for it
            if (!data.type.endsWith(EXECUTION_TYPE_STARTED)) {
              const searchLog = new CallLogSearch(searches[log.pk].type,
                                                  searches[log.pk].flowSid,
                                                  searches[log.pk].executionId);

              const [error, result] = await searchLog.get();
              if (error) {
                Logger.error({logCat, logSubCat, message: 'DynamoDB Result Error -> CallLogSearch -> get()', data: {code: error.statusCode, message: error.message}});
              } else {
                searches[log.pk] = merge(searches[log.pk], result);
                Logger.info({ logCat, logSubCat, message: 'DynamoDB Result -> CallLogSearch -> get()', data: searches[log.pk] });
              }
            }

            const [error, context] = await getExecutionContext(searches[log.pk].flowSid, searches[log.pk].executionId);
            if (error) {
              Logger.error({logCat, logSubCat, message: 'Execution Context Error', data: {code: error.statusCode, message: error.message}});
            } else {
              searches[log.pk].context = { ...context };
              Logger.info({ logCat, logSubCat, message: 'Execution Context', data: context });
            }
          }

          if (data.type.endsWith(EXECUTION_TYPE_STARTED)) {
            searches[log.pk].type = data.type;
            searches[log.pk].time = data.time;
            searches[log.pk].id = data.data.started_by;
            searches[log.pk].fromNumber = util.formatPhone(data.data.contact_channel_address);
          }

          if (data.type.endsWith(EXECUTION_TYPE_STEP_ENDED)) {
            if (!searches[log.pk]['type']) {
              searches[log.pk].type = data.type;
              searches[log.pk].time = data.time;
            }

            if (!searches[log.pk]['widgets'][data.id]) {
              searches[log.pk]['widgets'][data.id] = {
                time: data.time,
                name: data.data.transitioned_to,
                class: '',
                event: data.data.name
              };
            }
          }

          if (data.type.endsWith(EXECUTION_TYPE_ENDED)) {
            if (!searches[log.pk]['type']) {
              searches[log.pk].type = data.type;
              searches[log.pk].time = data.time;
              searches[log.pk].fromNumber = util.formatPhone(data.data.contact_channel_address);
            }
            searches[log.pk]['status'] = CALL_STATUS_COMPLETE;
            searches[log.pk]['reason'] = data.data.ended_reason;

            const diff = moment(data.data.date_updated).unix() - moment(data.data.date_created).unix();
            searches[log.pk]['duration'] = moment.duration(diff).asSeconds();
          }

          if (process.env.IS_LOCAL) {
            console.log('---------------');
            console.log(`Log: ${record.kinesis.sequenceNumber} - ${data.type} - ${data.data.execution_sid}`);
            console.log('---------------');
          }

          const [error, result] = await log.add(log);
          if (error) {
            Logger.error({logCat, logSubCat, message: 'DynamoDB Result Error -> CallLog', data: {code: error.statusCode, message: error.message}});
          } else {
            Logger.info({ logCat, logSubCat, message: 'DynamoDB Result -> CallLog', data: result });
          }
        } catch (err) {
          if (process.env.IS_LOCAL) {
            console.log(err);
          }
          Logger.error({logCat, logSubCat, message: 'DynamoDB Result Error', data: err});
        }
      }
      for (let key in searches) {
        if (searches[key].context.trigger.call) {
          searches[key].toNumber = util.formatPhone(searches[key].context.trigger.call.To);
          searches[key].direction = searches[key].context.trigger.call.Direction;
        }

        const log = new CallLogSearch(searches[key].type,
                                      searches[key].flowSid,
                                      searches[key].executionId,
                                      searches[key].time,
                                      searches[key].id,
                                      searches[key].fromNumber,
                                      searches[key].toNumber,
                                      searches[key].direction,
                                      searches[key].status,
                                      searches[key].duration,
                                      searches[key].reason);

          const [error, result] = await log.add(log);
          if (error) {
            Logger.error({logCat, logSubCat, message: 'DynamoDB Result Error -> CallLogSearch -> add()', data: {code: error.statusCode, message: error.message}});
          } else {
            Logger.info({ logCat, logSubCat, message: 'DynamoDB Result -> CallLogSearch -> add()', data: result });
          }

          for (let widget in searches[key].widgets) {
            const detail = new CallLogDetailSelfService(searches[key].executionId,
                                                         widget,
                                                         searches[key].widgets[widget].time,
                                                         searches[key].widgets[widget].name,
                                                         searches[key].widgets[widget].class,
                                                         searches[key].widgets[widget].event,
                                                         searches[key].widgets[widget].content);

            const [error, result] = await detail.add();
            if (error) {
              Logger.error({logCat, logSubCat, message: 'DynamoDB Result Error -> CallLogDetailSelfService -> add()', data: {code: error.statusCode, message: error.message}});
            } else {
              Logger.info({ logCat, logSubCat, message: 'DynamoDB Result -> CallLogDetailSelfService -> add()', data: result });
            }
          }
      }

      Logger.info({ logCat, logSubCat, message: 'Successfully processed', data: `${event.Records.length} records.` });
};

async function getRecordDataAsync(payload) {
    var data = Buffer.from(payload.data, "base64").toString("utf-8");
    await Promise.resolve(1); //Placeholder for actual async work
    return data;
}
