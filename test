const { unmarshall } = require("@aws-sdk/util-dynamodb");
const { ICallLogSearch } = require('./models/call-log-search');
const { getClient } = require('./client');
const util = require('./util');
const moment = require('moment');


getByDate = async (startDate, endDate) => {
        const client = getClient();

        try {

            let searches = [];

            let stDt, endDt

            // startDate and endDate are not null
            if(!(startDate === null) && !(endDate === null)){
                stDt =  { S: moment(`${startDate} 00:00:00`).format()}
                endDt = { S: moment(`${endDate} 23:59:00`).format()}
            } else if(!(startDate === null) && endDate === null){ // If Only endDate is null use endDate now
                stDt =  { S: moment(`${startDate} 00:00:00`).format()}
                endDt = { S: moment().format()}
            } else if(startDate === null && !(endDate === null)){ // If Only startDate is null use provided endDate and startDate 1 day before endDate
                stDt =  { S: moment(endDate).subtract(1, 'days').format()}
                endDt = { S: moment(`${endDate} 23:59:00`).format()}
            } else if(startDate === null && endDate === null){ // If startDate and endDate are null use endDate now and startDate 1 day before endDate
                console.log(moment().subtract(1, 'days').format())
                stDt =  { S: moment().subtract(1, 'days').format()}
                endDt = { S: moment().format()}
            }

            // If endDate.isBefore than startDate Throw an error
            if(moment(endDt).isBefore(moment(stDt))){
                throw new Error('Start Date Must to Be Before or Equal to End Date')
            }

            let attributes = {
                ":gsi1pk": { S: this.getGSI1PK() },
                ":startdate":stDt,
                ":enddate": endDt
            };
           
            const result = await client
                .query({
                    TableName: process.env.DB_TABLE_NAME,
                    IndexName: "GSI1",
                    KeyConditionExpression: "GSI1PK = :gsi1pk AND GSI1SK BETWEEN :startdate AND :enddate",
                    ExpressionAttributeValues: attributes,
                    ScanIndexForward: false
                })
                .promise();

            searches = result.Items.map((item) => unmarshall(item))
            return [null, searches ];
